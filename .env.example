# Server-side only. Never prefix these with VITE_ — that would expose them to the browser.

# Solana mainnet RPC endpoint (use a dedicated provider, not the public endpoint).
SOLANA_RPC_URL=https://your-rpc-provider.example.com/?api-key=REPLACE_ME

# Jupiter aggregator API base URL.
JUPITER_API_URL=https://lite-api.jup.ag
